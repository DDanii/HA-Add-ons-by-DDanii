{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Kittygram from Codeberg package dates",
      "managerFilePatterns": ["/^kittygram\\/config\\.json$/"],
      "matchStrings": ["\"version\"\\s*:\\s*\"(?<currentValue>(?:\\d+\\.){0,3}\\d+)\""],
      "depNameTemplate": "kittygram",
      "datasourceTemplate": "custom.kittygram-package",
      "versioningTemplate": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?(?:\\.(?<build>\\d+))?$",
      "autoReplaceStringTemplate": "\"version\": \"{{{newValue}}}\""
    },
    {
      "customType": "regex",
      "description": "Update Structables from Forgejo tags",
      "managerFilePatterns": ["/^structables\\/config\\.json$/"],
      "matchStrings": ["\"version\"\\s*:\\s*\"1\\d{4}\\.(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "forgejo-tags",
      "packageNameTemplate": "privatecoffee/structables",
      "registryUrlTemplate": "https://git.private.coffee",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "autoReplaceStringTemplate": "\"version\": \"1{{{replace '^([0-9]{4}).*' '$1' releaseTimestamp}}}.{{{newValue}}}\""
    },
    {
      "customType": "regex",
      "description": "Update Wikimore from Forgejo tags",
      "managerFilePatterns": ["/^wikimore\\/config\\.json$/"],
      "matchStrings": ["\"version\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      "datasourceTemplate": "forgejo-tags",
      "packageNameTemplate": "privatecoffee/wikimore",
      "registryUrlTemplate": "https://git.private.coffee",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update Small from Forgejo tags",
      "managerFilePatterns": ["/^small\\/config\\.json$/"],
      "matchStrings": ["\"version\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:\\.\\d+)?\""],
      "datasourceTemplate": "forgejo-tags",
      "packageNameTemplate": "privatecoffee/small",
      "registryUrlTemplate": "https://git.private.coffee",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Update Phantom from Codeberg package dates",
      "managerFilePatterns": ["/^phantom\\/config\\.json$/"],
      "matchStrings": ["\"version\"\\s*:\\s*\"(?:(?:\\d+\\.){3})?(?<currentValue>\\d+(?:\\.\\d+\\.\\d+)?)\""],
      "depNameTemplate": "phantom",
      "datasourceTemplate": "custom.phantom-package",
      "versioningTemplate": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?$",
      "autoReplaceStringTemplate": "\"version\": \"{{{newValue}}}\""
    },
    {
      "customType": "regex",
      "description": "Update Binternet from GitHub commit dates",
      "managerFilePatterns": ["/^binternet\\/config\\.json$/"],
      "matchStrings": ["\"version\"\\s*:\\s*\"(?<currentValue>\\d{4}\\.\\d{1,2}\\.\\d{1,2})\""],
      "depNameTemplate": "binternet",
      "datasourceTemplate": "custom.binternet-commit-date",
      "versioningTemplate": "regex:^(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?$",
      "autoReplaceStringTemplate": "\"version\": \"{{{newValue}}}\""
    }
  ],
  "customDatasources": {
    "kittygram-package": {
      "defaultRegistryUrlTemplate": "https://codeberg.org/api/v1/packages/irelephant?limit=100",
      "transformTemplates": [
        "{\"releases\": [$map($filter($, function($v) { $v.type = 'container' and $v.name = 'kittygram' and $v.version = 'latest' }), function($v) { {\"version\": $replace($v.created_at, /^(\\d{4})-0?(\\d{1,2})-0?(\\d{1,2}).*/, \"$1.$2.$3\")} })]}"
      ]
    },
    "phantom-package": {
      "defaultRegistryUrlTemplate": "https://codeberg.org/api/v1/packages/phantom-org?limit=100",
      "transformTemplates": [
        "{\"releases\": [$map($filter($, function($v) { $v.type = 'container' and $v.name = 'phantom' and $contains($v.version, /^\\d{4}\\.\\d{2}\\.\\d{2}-/) }), function($v) { {\"version\": $replace($v.created_at, /^(\\d{4})-0?(\\d{1,2})-0?(\\d{1,2}).*/, \"$1.$2.$3\")} })]}"
      ]
    },
    "binternet-commit-date": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/Ahwxorg/Binternet/commits?per_page=1",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $replace($[0].commit.committer.date, /^(\\d{4})-0?(\\d{1,2})-0?(\\d{1,2}).*/, \"$1.$2.$3\")}]}"
      ]
    }
  }
}